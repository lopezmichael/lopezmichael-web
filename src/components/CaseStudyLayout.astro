---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectHeader from './ProjectHeader.astro';
import LabeledSection from './LabeledSection.astro';
import NextProject from './NextProject.astro';
import ProjectFigure from './ProjectFigure.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  metaDescription?: string;
  techStack?: string[];
  metrics?: { label: string; value: string }[];
}

const { project, metaDescription, techStack, metrics } = Astro.props;

// Problem / Approach / Outcome / Reflection are sections, not a sequence, so they get labels
// rather than numerals (docs/design-principles.md, principle 7).
const sections = [
  { slot: 'problem', label: 'Problem' },
  { slot: 'approach', label: 'Approach' },
  { slot: 'outcome', label: 'Outcome' },
  { slot: 'reflection', label: 'Reflection' },
].filter((s) => Astro.slots.has(s.slot));
// The pull quote sits just before Outcome (or after the last section if there is no Outcome).
const pullquote = Astro.slots.has('pullquote') ? await Astro.slots.render('pullquote') : null;
const rendered = await Promise.all(sections.map((s) => Astro.slots.render(s.slot)));
// A case study's interactive chart goes in the "figure" slot; until it has one, the screenshot shows.
const hasFigure = Astro.slots.has('figure');
const outcomeAt = sections.findIndex((s) => s.slot === 'outcome');
const pullquoteIndex = outcomeAt >= 0 ? outcomeAt : sections.length;
---

<BaseLayout title={project.title} description={metaDescription || project.description}>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <ProjectHeader project={project} kind="Case study" />

    {metrics && metrics.length > 0 && (
      <dl class="m-0 grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-8 pb-12">
        {metrics.map((m) => (
          <div class="flex flex-col-reverse border-t border-line pt-4">
            <dt class="eyebrow mt-3">{m.label}</dt>
            <dd class="m-0 font-display font-bold text-[clamp(2.25rem,4.5vw,3.5rem)] leading-none tracking-[-0.02em] tabular-nums">{m.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {hasFigure ? <figure class="m-0 pb-16 sm:pb-20"><slot name="figure" /></figure> : <ProjectFigure project={project} />}

    <div class="flex flex-col gap-14 sm:gap-20">
      {[...sections, null].map((s, i) => (
        <>
          {pullquote && i === pullquoteIndex && (
            <div class="grid md:grid-cols-[1fr_3fr] md:gap-10">
              <blockquote class="md:col-start-2 m-0 font-serif text-[clamp(1.6rem,3.4vw,2.6rem)] leading-[1.15] tracking-[-0.01em] max-w-[28ch] text-balance">
                <Fragment set:html={pullquote} />
              </blockquote>
            </div>
          )}
          {s && (
            <LabeledSection label={s.label}>
              <div class="prose-flow"><Fragment set:html={rendered[i]} /></div>
            </LabeledSection>
          )}
        </>
      ))}

      {techStack && techStack.length > 0 && (
        <LabeledSection label="Built with">
          <ul class="list-none m-0 p-0 grid sm:grid-cols-2 gap-x-8 gap-y-2 text-[0.95rem] max-w-[65ch]">
            {techStack.map((t) => <li class="border-b border-line pb-2">{t}</li>)}
          </ul>
        </LabeledSection>
      )}
    </div>

    <div class="mt-20 sm:mt-28">
      <NextProject current={project.slug} />
    </div>
  </article>
</BaseLayout>
