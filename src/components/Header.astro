---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// Home is reached through the name; "Work" is the projects index.
const navItems = [
  { label: 'Work', href: '/projects/' },
  { label: 'About', href: '/about/' },
  { label: 'Resume', href: '/resume/' },
];

function isActive(href: string, path: string): boolean {
  const normalized = path.endsWith('/') ? path : path + '/';
  // Case studies live under /projects/, so they keep "Work" lit.
  return normalized === href || (href === '/projects/' && normalized.startsWith('/projects/'));
}
---

<header class="sticky top-0 z-40 bg-page/95 backdrop-blur-sm border-b border-line transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-3 sm:py-0 sm:h-16">
      <a href="/" class="font-display font-bold text-[1.05rem] tracking-[-0.01em] text-ink no-underline">
        Michael Lopez
      </a>

      <nav class="order-last w-full sm:order-none sm:w-auto flex items-center gap-6 text-sm" aria-label="Main navigation">
        {navItems.map((item) => {
          const active = isActive(item.href, currentPath);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'py-2 transition-opacity text-ink',
                active
                  ? 'underline decoration-wine decoration-2 underline-offset-[6px]'
                  : 'no-underline opacity-75 hover:opacity-100',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-4">
        <!-- Local time in Dallas. Server-rendered without a time so a no-JS page never shows a stale one. -->
        <span class="hidden md:flex items-center gap-2 font-mono text-xs text-muted whitespace-nowrap">
          <span class="w-1.5 h-1.5 rounded-full bg-wine" aria-hidden="true"></span>
          <span data-dallas-clock>Dallas, Texas</span>
        </span>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script>
  // Desktop only (the clock is hidden below md). Ticks on the minute so it never shows a stale one.
  function startClock() {
    const el = document.querySelector<HTMLElement>('[data-dallas-clock]');
    if (!el || !window.matchMedia('(min-width: 768px)').matches) return;
    let fmt: Intl.DateTimeFormat;
    try {
      fmt = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' });
    } catch {
      return; // Keep the static "Dallas, Texas" label.
    }
    const tick = () => {
      el.textContent = `Dallas · ${fmt.format(new Date())} CT`;
      window.setTimeout(tick, 60_000 - (Date.now() % 60_000));
    };
    tick();
  }
  startClock();
</script>
