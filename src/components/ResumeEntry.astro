---
interface Props {
  title: string;
  /** Omitted inside the CPAL timeline, where the employer heads the group. */
  company?: string;
  dates: string;
  summary?: string;
  bullets: string[];
}

const { title, company, dates, summary, bullets } = Astro.props;
---

<article>
  <p class="eyebrow m-0">{dates}</p>
  <h4 class="m-0 mt-1.5 font-display font-bold text-[1.2rem] tracking-[-0.01em]">{title}</h4>
  {company && <p class="m-0 mt-0.5 text-wine text-sm">{company}</p>}
  {summary && <p class="m-0 mt-3 font-serif italic text-[1.1rem] leading-snug max-w-[60ch]">{summary}</p>}
  <ul class="mt-3 mb-0 pl-5 list-disc marker:text-muted flex flex-col gap-1.5 max-w-[65ch] text-[0.95rem] leading-relaxed">
    {bullets.map((bullet) => <li>{bullet}</li>)}
  </ul>
</article>
