---
import { skills } from '../data/resume';

interface Props {
  /** Category labels to show, in this order. Omit to show every category. */
  only?: string[];
}
const { only } = Astro.props;
const shown = only
  ? only.map((label) => skills.find((c) => c.label === label)).filter((c) => c !== undefined)
  : skills;
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-10">
  {shown.map((cat) => (
    <div>
      <h3 class="eyebrow m-0 pb-2 border-b border-line">{cat.label}</h3>
      <ul class="list-none m-0 p-0">
        {cat.items.map((item) => <li class="border-b border-line py-2 text-[0.95rem]">{item}</li>)}
      </ul>
    </div>
  ))}
</div>
