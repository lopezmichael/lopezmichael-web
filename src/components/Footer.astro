---
const year = new Date().getFullYear();
const email = 'michael@lopezstudio.dev';

const links = [
  { label: 'GitHub', href: 'https://github.com/lopezmichael' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/michael-d-lopez' },
  { label: 'Email', href: `mailto:${email}` },
];
---

<footer class="border-t border-line">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 sm:pt-20 pb-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <p class="font-serif text-[clamp(2.2rem,6vw,4.6rem)] leading-none m-0" data-hello>
        Say <em class="inline-block text-wine transition-transform duration-300 ease-[cubic-bezier(.3,1.6,.5,1)] motion-reduce:transition-none" data-hello-word>hello.</em>
      </p>
      <button
        type="button"
        data-copy-email={email}
        class="inline-flex items-center gap-3 font-mono text-sm px-4 py-2.5 border border-ink rounded-full bg-transparent text-ink cursor-pointer transition-colors hover:bg-wine-deep hover:text-on-wine hover:border-wine-deep"
      >
        <span data-email-text>{email}</span>
        <span class="font-sans text-xs opacity-70" data-copy-state aria-live="polite">Copy</span>
      </button>
    </div>

    <div class="mt-12 pt-6 border-t border-line flex flex-wrap items-center justify-between gap-4 text-xs text-muted">
      <span>&copy; {year} Michael Lopez</span>
      <nav aria-label="Elsewhere" class="flex gap-5">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="text-muted hover:text-ink"
          >
            {link.label}
          </a>
        ))}
      </nav>
      <span>Dallas, Texas</span>
    </div>
  </div>
</footer>

<script>
  function setupCopyEmail() {
    const btn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
    const state = document.querySelector<HTMLElement>('[data-copy-state]');
    const word = document.querySelector<HTMLElement>('[data-hello-word]');
    if (!btn || !state) return;
    const address = btn.dataset.copyEmail ?? '';
    let timer = 0;

    const show = (copied: boolean) => {
      state.textContent = copied ? 'Copied' : 'Select to copy';
      if (copied && word) {
        word.textContent = 'hello!';
        word.style.transform = 'rotate(-6deg) scale(1.08)';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        state.textContent = 'Copy';
        if (word) {
          word.textContent = 'hello.';
          word.style.transform = '';
        }
      }, 1800);
    };

    // Fallback when the clipboard is unavailable: select the address so the visitor can copy it.
    const selectAddress = () => {
      const text = btn.querySelector('[data-email-text]');
      const sel = window.getSelection();
      if (!text || !sel) return;
      const range = document.createRange();
      range.selectNodeContents(text);
      sel.removeAllRanges();
      sel.addRange(range);
    };

    btn.addEventListener('click', () => {
      if (!navigator.clipboard?.writeText) {
        selectAddress();
        show(false);
        return;
      }
      navigator.clipboard.writeText(address).then(
        () => show(true),
        () => { selectAddress(); show(false); },
      );
    });
  }
  setupCopyEmail();
</script>
