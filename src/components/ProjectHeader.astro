---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Eyebrow above the title: "Case study" or "Project". */
  kind: string;
}

const { project, kind } = Astro.props;
const isExternal = project.href.startsWith('http') && !project.restricted;
---

<header class="pt-8 sm:pt-10 pb-10 sm:pb-14">
  <a href="/projects/" class="eyebrow hover:text-ink">
    <span aria-hidden="true">←</span> All work
  </a>
  <p class="eyebrow m-0 mt-10">{kind}</p>
  <h1 class="m-0 mt-3 font-display font-extrabold text-[clamp(2.4rem,6vw,5rem)] leading-[0.95] tracking-[-0.03em] max-w-[18ch] text-balance">
    {project.title}
  </h1>
  <p class="m-0 mt-6 font-serif text-[clamp(1.25rem,2.2vw,1.75rem)] leading-snug max-w-[38ch]">
    {project.description}
  </p>
  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
    <p class="m-0 text-xs uppercase tracking-[0.08em] text-muted">{project.tags.join(' · ')}</p>
    {isExternal && (
      <a href={project.href} target="_blank" rel="noopener noreferrer" class="btn-primary px-4 py-2">
        Visit live
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
        </svg>
      </a>
    )}
  </div>
</header>
