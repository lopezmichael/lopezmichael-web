---
import BaseLayout from '../layouts/BaseLayout.astro';
import LabeledSection from '../components/LabeledSection.astro';
import ResumeEntry from '../components/ResumeEntry.astro';
import { contact, experience, education, skills, webBullets, webProjects } from '../data/resume';

// CPAL roles are the connected spine; everything else collapses under an
// "Earlier experience" disclosure. Filter on `group` rather than by position —
// a positional slice(0, 4) disagreed with the PDF generator the moment a fifth
// CPAL role was added.
const primaryExperience = experience.filter((e) => e.group === 'cpal');
const earlierExperience = experience.filter((e) => e.group !== 'cpal');
const projects = webProjects();

// Set to true once public/files/Michael_Lopez_Resume.pdf is added.
const hasResumePdf = true;
---

<BaseLayout
  title="Resume"
  description="Michael Lopez resume. Data leader with experience in civic tech, housing policy, and nonprofit data infrastructure."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
    <LabeledSection label="Resume" labelAs="p" class="pt-10 sm:pt-14 pb-14 sm:pb-20">
      <h1 class="m-0 font-display font-extrabold text-[clamp(2.6rem,7vw,5.5rem)] leading-[0.95] tracking-[-0.03em]">
        Michael <span class="font-serif italic font-normal text-wine tracking-[-0.01em]">Lopez</span>
      </h1>
      <p class="m-0 mt-5 font-medium">Director, Data Operations · Child Poverty Action Lab</p>
      <p class="m-0 mt-2 font-serif text-[1.25rem] leading-snug max-w-[40ch]">I turn messy administrative data into decisions people act on.</p>
    </LabeledSection>

    <div class="grid lg:grid-cols-[1fr_3fr] gap-14 lg:gap-10 items-start">
      <!-- Sidebar: contact, PDF, skills. Not sticky: with every skill category it can outgrow the screen.
           Follows the main column on narrow screens. -->
      <aside class="order-last lg:order-first flex flex-col gap-8 text-sm">
        <div>
          <h2 class="eyebrow m-0 pb-2 border-b border-line">Contact</h2>
          <ul class="list-none m-0 p-0">
            <li class="border-b border-line py-2"><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li class="border-b border-line py-2"><a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            <li class="border-b border-line py-2"><a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          </ul>
        </div>

        {hasResumePdf && (
          <a href="/files/Michael_Lopez_Resume.pdf" download class="btn-primary gap-2 px-4 py-2 self-start">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" />
            </svg>
            Download PDF
          </a>
        )}

        <div>
          <h2 class="eyebrow m-0 pb-2 border-b border-line">Skills</h2>
          <dl class="m-0">
            {skills.map((cat) => (
              <div class="border-b border-line py-2.5">
                <dt class="font-semibold">{cat.label}</dt>
                <dd class="m-0 mt-0.5 text-muted leading-relaxed">{cat.items.join(' · ')}</dd>
              </div>
            ))}
          </dl>
        </div>
      </aside>

      <div class="min-w-0 flex flex-col gap-16 sm:gap-20">
        <section>
          <h2 class="eyebrow m-0 pb-2 border-b border-line">Experience</h2>
          <header class="mt-8 mb-8">
            <p class="eyebrow m-0">2020 to present</p>
            <h3 class="m-0 mt-1.5 font-display font-extrabold text-[clamp(1.6rem,3vw,2.2rem)] tracking-[-0.02em]">Child Poverty Action Lab</h3>
            <p class="m-0 mt-2 text-muted max-w-[60ch]">Four-role progression from analytics associate to director of data operations.</p>
          </header>

          <ol class="list-none m-0 p-0 relative border-l border-line pl-8 flex flex-col gap-12">
            {primaryExperience.map((entry) => (
              <li class="relative">
                <span class="absolute -left-[37px] top-1.5 w-2.5 h-2.5 rounded-full bg-wine ring-4 ring-page" aria-hidden="true"></span>
                <ResumeEntry title={entry.title} dates={entry.dates} summary={entry.summary} bullets={webBullets(entry)} />
              </li>
            ))}
          </ol>

          {earlierExperience.length > 0 && (
            <details class="group mt-12 border-t border-line">
              <summary class="cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden py-4">
                <h3 class="eyebrow m-0 inline-flex items-center gap-2 hover:text-ink">
                  <span class="transition-transform group-open:rotate-90 motion-reduce:transition-none" aria-hidden="true">→</span>
                  Earlier experience ({earlierExperience.length} roles)
                </h3>
              </summary>
              <div class="pt-4 flex flex-col gap-10">
                {earlierExperience.map((entry) => (
                  <ResumeEntry
                    title={entry.title}
                    company={entry.company}
                    dates={entry.dates}
                    summary={entry.summary}
                    bullets={webBullets(entry)}
                  />
                ))}
              </div>
            </details>
          )}
        </section>

        <section>
          <h2 class="eyebrow m-0 pb-2 border-b border-line">Education</h2>
          <ul class="list-none m-0 p-0">
            {education.map((edu) => (
              <li class="border-b border-line py-4">
                {edu.year && <p class="eyebrow m-0 mb-1">{edu.year}</p>}
                <p class="m-0 font-display font-bold text-[1.1rem]">{edu.degree}</p>
                <p class="m-0 mt-0.5 text-wine text-sm">{edu.school}</p>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="eyebrow m-0 pb-2 border-b border-line">Selected projects</h2>
          <ul class="list-none m-0 p-0 max-w-[70ch]">
            {projects.map((proj) => (
              <li class="border-b border-line py-3 text-[0.95rem] leading-relaxed">
                <strong class="font-semibold">{proj.name}</strong>:{' '}
                {proj.href ? (
                  <a href={proj.href} target="_blank" rel="noopener noreferrer">{proj.description}</a>
                ) : (
                  <span>{proj.description}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
