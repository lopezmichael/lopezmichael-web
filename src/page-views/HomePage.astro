---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerrainBand from '../components/TerrainBand.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import { featuredProjects, projects } from '../data/projects';
---

<BaseLayout
  title="Michael Lopez"
  description="Data leader working in civic tech and social impact. Building the teams and data systems that help communities act on what they know."
>
  <!-- Hero: the one big type moment on the page (principle 1). -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-8">
    <h1 class="m-0 font-normal leading-[0.86]">
      <span class="block font-display font-extrabold uppercase tracking-[-0.035em] text-[clamp(3.4rem,15.5vw,12.5rem)]">Michael</span>
      <span class="block font-serif italic text-wine text-right tracking-[-0.02em] text-[clamp(3.6rem,16vw,13rem)] -mt-[0.08em] pr-[0.04em]">Lopez</span>
    </h1>
    <div class="flex flex-wrap items-end justify-between gap-5 mt-[clamp(1.25rem,4.5vw,3.75rem)]">
      <p class="m-0 font-serif text-[clamp(1.15rem,2vw,1.5rem)] leading-tight max-w-[30ch]">
        Data Leader · Civic Tech &amp; Social Impact
      </p>
      <p class="m-0 text-sm text-muted sm:text-right max-w-[30ch]">
        Building the teams and data systems that help communities act on what they know.
      </p>
    </div>
  </section>

  <TerrainBand />

  <!-- Now -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 grid md:grid-cols-[1fr_3fr] gap-6 md:gap-10">
    <p class="eyebrow m-0 border-t border-line pt-2.5 self-start">Now</p>
    <div>
      <h2 class="m-0 mb-6 font-serif font-normal text-[clamp(2rem,4.6vw,3.8rem)] leading-[1.02] tracking-[-0.015em] max-w-[18ch] text-balance">
        Data should reach the people <em class="text-wine">closest to the problem.</em>
      </h2>
      <p class="m-0 text-[1.05rem] leading-relaxed max-w-[62ch]">
        I lead the data function at the Child Poverty Action Lab, a backbone organization working on
        child poverty across North Texas. That means the team, the roadmap, the platform
        underneath, and the tools that get data in front of people who can act on it. The stubborn
        idea pulling it together: most of the data that could help families is sitting somewhere it
        can't reach them. Most of the job is closing that gap.
      </p>
    </div>
  </section>

  <!-- Selected work -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
    <ProjectIndex
      projects={featuredProjects}
      label="Selected work"
      more={{ label: `All ${projects.length} projects`, href: '/projects/' }}
    />
  </section>
</BaseLayout>
