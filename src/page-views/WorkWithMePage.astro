---
import BaseLayout from '../layouts/BaseLayout.astro';
import LabeledSection from '../components/LabeledSection.astro';
import { contact } from '../data/resume';

const engagements = [
  {
    title: 'Data strategy & analysis',
    lead: 'I help orgs figure out what their data can actually answer, and turn it into decisions.',
    looksLike: [
      'Turning a messy dataset into a clear answer',
      'Analysis and data viz for a specific question',
      'A data roadmap: what to build, measure, and prioritize',
    ],
    goodFit: [
      'You have data but not the answers you need',
      'You want an analysis done right, once',
      'You need a plan before you hire or build a team',
    ],
  },
  {
    title: 'Data-forward tools & products',
    lead: 'I build the tools, dashboards, and sites that put data into the hands of the people who use it.',
    looksLike: [
      'Internal tools for non-technical staff (CRUD, lookup)',
      'R Shiny dashboards and interactive data products',
      'Astro / Preact sites and public data tools',
    ],
    goodFit: [
      'You need a custom tool but lack in-house dev capacity',
      'You want a public-facing data product for transparency',
      'You need a thoughtful website for a small org or practice',
    ],
  },
  {
    title: 'Data infrastructure & stack',
    lead: 'I help orgs build data infrastructure they can grow into.',
    looksLike: [
      'Databricks (or similar) setup and migration',
      'Pipeline architecture and ETL design',
      'AI workflow integration',
    ],
    goodFit: [
      "You're outgrowing file-based or fragmented tooling",
      'You have data but no scalable way to manage it',
      'You want to introduce AI tooling thoughtfully',
    ],
  },
];

const howIWork = [
  {
    title: 'Scope',
    body: 'Low-to-medium scale, typically a few weeks to a few months of part-time work. For larger projects, I can help you scope, plan, and find the right team for the job.',
  },
  {
    title: 'Schedule',
    body: 'I take on independent work outside my full-time role, one project at a time. That keeps the focus high and the timeline honest, so we scope to what I can genuinely deliver.',
  },
  {
    title: 'Style',
    body: 'Every engagement starts with a free 30-minute call to understand the work and check fit. Then a written proposal with deliverables, timeline, and rate. I work iteratively and communicate frequently.',
  },
  {
    title: 'Rates',
    body: 'Flexible based on org type, scope, and budget. Happy to discuss what works for you.',
  },
];
---

<BaseLayout
  title="Work with me"
  description="Occasional small projects alongside my full-time role at the Child Poverty Action Lab: data strategy, data-forward tools, and data infrastructure for nonprofits."
  noindex
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24 flex flex-col gap-16 sm:gap-24">
    <LabeledSection label="Work with me" labelAs="p" class="pt-10 sm:pt-14">
      <h1 class="m-0 font-display font-extrabold text-[clamp(2.6rem,7vw,5.5rem)] leading-[0.95] tracking-[-0.03em]">
        Work <span class="font-serif italic font-normal text-wine tracking-[-0.01em]">with me</span>
      </h1>
      <div class="prose-flow mt-6">
        <p>
          Alongside my full-time role at the Child Poverty Action Lab, I'm open to the occasional
          small project. Low-to-medium scale, small enough that
          one person can do the whole thing well.
        </p>
        <p class="font-serif text-[1.25rem]">Open to a project or two. Let's see if we're a fit.</p>
      </div>
    </LabeledSection>

    <LabeledSection label="What I help with">
      <div class="flex flex-col border-t border-line">
        {engagements.map((e) => (
          <article class="border-b border-line py-8 first:pt-6">
            <h3 class="m-0 font-display font-bold text-[clamp(1.35rem,2.4vw,1.9rem)] tracking-[-0.02em]">{e.title}</h3>
            <p class="m-0 mt-2 font-serif text-[1.2rem] leading-snug max-w-[48ch]">{e.lead}</p>
            <div class="mt-5 grid sm:grid-cols-2 gap-6 text-[0.95rem]">
              <div>
                <p class="eyebrow m-0 mb-2">What this looks like</p>
                <ul class="m-0 pl-5 list-disc marker:text-muted flex flex-col gap-1">
                  {e.looksLike.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div>
                <p class="eyebrow m-0 mb-2">Good fit if</p>
                <ul class="m-0 pl-5 list-disc marker:text-muted flex flex-col gap-1">
                  {e.goodFit.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </LabeledSection>

    <LabeledSection label="How I work">
      <dl class="m-0 grid sm:grid-cols-2 gap-x-10 border-t border-line">
        {howIWork.map((item) => (
          <div class="border-b border-line py-6">
            <dt class="font-display font-bold text-[1.25rem] tracking-[-0.01em]">{item.title}</dt>
            <dd class="m-0 mt-2 leading-relaxed">{item.body}</dd>
          </div>
        ))}
      </dl>
    </LabeledSection>

    <LabeledSection label="Get in touch" labelAs="p">
      <h2 class="m-0 font-serif font-normal text-[clamp(1.8rem,3.6vw,2.8rem)] leading-tight">Have a project in mind?</h2>
      <p class="m-0 mt-4 leading-relaxed max-w-[60ch]">
        The fastest way to start is to email me with a brief description of the project,
        your timeline, and your budget range (if you have one). I usually respond within
        a couple of days.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href={`mailto:${contact.email}?subject=Project%20inquiry`} class="btn-primary px-5 py-2.5">{contact.email}</a>
        <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="btn-outline px-5 py-2.5">LinkedIn</a>
      </div>
      <p class="m-0 mt-5 text-xs text-muted max-w-[60ch]">
        Lopez Studio is the name I use for independent work, so <span class="whitespace-nowrap">{contact.email}</span> is the right address for project inquiries.
      </p>
    </LabeledSection>
  </div>
</BaseLayout>
