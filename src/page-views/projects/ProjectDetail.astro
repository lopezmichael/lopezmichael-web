---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
import LabeledSection from '../../components/LabeledSection.astro';
import NextProject from '../../components/NextProject.astro';
import ProjectFigure from '../../components/ProjectFigure.astro';
import { projectSeo, type Project } from '../../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const seo = projectSeo(project, Astro.site!);
---

<BaseLayout {...seo}>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <ProjectHeader project={project} kind="Project" />

    <ProjectFigure project={project} />

    <div class="flex flex-col gap-14 sm:gap-20">
      <LabeledSection label="About">
        <div class="prose-flow"><p>{project.longDescription}</p></div>
      </LabeledSection>

      {project.highlights && project.highlights.length > 0 && (
        <LabeledSection label="Highlights">
          <ul class="list-none m-0 p-0 max-w-[65ch] text-[1.05rem] leading-relaxed">
            {project.highlights.map((h) => <li class="border-b border-line py-3 first:pt-0">{h}</li>)}
          </ul>
        </LabeledSection>
      )}
    </div>

    <div class="mt-20 sm:mt-28">
      <NextProject current={project.slug} />
    </div>
  </article>
</BaseLayout>
