---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import LabeledSection from '../components/LabeledSection.astro';
import { projects, type Project } from '../data/projects';

const groups: { label: string; category: Project['category'] }[] = [
  { label: 'Civic data & infrastructure', category: 'civic' },
  { label: 'Community data', category: 'community' },
  { label: 'Other work', category: 'other' },
];
---

<BaseLayout
  title="Projects"
  description="Selected work by Michael Lopez: building a nonprofit's data operations, civic data systems, and community-driven data products."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <LabeledSection label="Work" labelAs="p" class="pt-10 sm:pt-14 pb-12 sm:pb-16">
      <h1 class="m-0 font-display font-extrabold text-[clamp(2.6rem,7vw,5.5rem)] leading-[0.95] tracking-[-0.03em]">
        Selected <span class="font-serif italic font-normal text-wine tracking-[-0.01em]">work</span>
      </h1>
      <p class="m-0 mt-6 text-[1.05rem] leading-relaxed max-w-[62ch]">
        Leading data operations at a nonprofit and the systems they run on, plus a community data platform
        I built and run on my own.
      </p>
    </LabeledSection>

    <div class="flex flex-col gap-14 sm:gap-20 pb-16 sm:pb-24">
      {groups.map(({ label, category }) => {
        const items = projects.filter((p) => p.category === category);
        return items.length > 0 && <ProjectIndex projects={items} label={label} />;
      })}
    </div>
  </div>
</BaseLayout>
