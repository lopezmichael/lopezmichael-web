---
import BaseLayout from '../layouts/BaseLayout.astro';
import LabeledSection from '../components/LabeledSection.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import { contact, webMedia } from '../data/resume';

// webMedia() honors `only`, so print-only entries never reach the site.
const media = webMedia();
const mediaGroups = [
  { label: 'Featured in', items: media.filter((m) => m.type === 'press') },
  { label: 'Data visualizations contributed to', items: media.filter((m) => m.type === 'visualization') },
].filter((g) => g.items.length > 0);

// One item carries a link; the rest are plain text. Rendered as markup, so text is always escaped.
const built: { text: string; link?: { label: string; href: string }; after?: string }[] = [
  { text: 'A 30+ Shiny app suite informing decisions across CPAL focus areas: housing, public safety, maternal health, benefits delivery, and criminal justice.' },
  {
    text: 'An eviction data workstream feeding newly-filed cases daily to 12+ partner organizations across legal aid, advocacy, government, and academic research; the data behind ',
    link: { label: 'North Texas Evictions', href: 'https://northtexasevictions.org' },
    after: '.',
  },
  { text: 'Internal tools that let non-data staff act on data without analyst intervention, including a parcel-level outreach tool with 20 active field-team users.' },
  { text: "The Databricks platform migration on AWS, moving the org's pipelines off file-based storage onto unified, governed cloud infrastructure with Git-tracked orchestration." },
  { text: 'AI-assisted workflows (Claude Code with custom skills and agents) that the team uses every day to develop pipelines, write documentation, and review code.' },
  { text: 'A data team grown from two people to two in-house data engineers and a four-person vendor engineering team, all working from one internal data roadmap.' },
];
---

<BaseLayout
  title="About"
  description="Michael Lopez, Director of Data Operations at the Child Poverty Action Lab. Turning administrative data into analysis and decisions communities can act on."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24 flex flex-col gap-16 sm:gap-24">
    <LabeledSection label="About" labelAs="p" class="pt-10 sm:pt-14">
      <h1 class="m-0 font-display font-extrabold text-[clamp(2.6rem,7vw,5.5rem)] leading-[0.95] tracking-[-0.03em]">
        Hi, I'm <span class="font-serif italic font-normal text-wine tracking-[-0.01em]">Michael</span>
      </h1>

      <div class="mt-10 grid lg:grid-cols-[minmax(0,1fr)_14rem] gap-10 lg:gap-14 items-start">
        <div class="prose-flow">
          <p>
            I lead data operations at the <a href="https://childpovertyactionlab.org" target="_blank" rel="noopener noreferrer">Child Poverty Action Lab</a>,
            a backbone organization for nonprofits across North Texas. CPAL works on the things that actually
            change child poverty in Dallas: public safety, maternal health, benefits delivery,
            housing, and criminal justice. I run our data engineering team, the data platform
            (Databricks, AI-enabled workflows), and the internal tools that put data in front of
            non-technical staff and partner orgs.
          </p>
          <p>
            It took a few detours to get here. My first real job was coordinating a child development lab
            at UT Dallas, and the part that stuck with me wasn't the research itself, it was sitting with
            the parents of our young participants and trying to explain what we'd found. The gap between
            how researchers talk to each other and how findings actually reach the people who can do
            something with them turned out to be the thread of my career. It pulled me through a policy
            internship at <a href="https://childrenatrisk.org" target="_blank" rel="noopener noreferrer">Children at Risk</a>,
            an MPP at UT Dallas, and into CPAL in 2020.
          </p>
          <p>
            Two convictions sit underneath the work. First: <strong>public data is only useful when the
            people closest to a problem can act on it</strong>, and most of the data that could help families
            is still locked up in formats and systems that field-team workers, community organizations, and
            decision-makers can't reach. Second: <strong>nonprofits deserve the same data infrastructure as
            the institutions and markets they're often working against.</strong> Most of what I do, at CPAL
            and outside of it, is in service of those two ideas.
          </p>
        </div>

        <aside class="flex lg:flex-col items-center lg:items-start gap-5 text-sm">
          <!-- Monogram placeholder until a real photo is added. -->
          <div class="w-24 h-24 lg:w-full lg:h-auto lg:aspect-square shrink-0 rounded-md bg-wine-deep text-on-wine flex items-center justify-center" role="img" aria-label="Michael Lopez monogram">
            <span class="font-display font-extrabold text-4xl lg:text-7xl tracking-[-0.03em] select-none" aria-hidden="true">ML</span>
          </div>
          <div>
            <p class="m-0 font-semibold">Director, Data Operations</p>
            <p class="m-0 mt-0.5 text-wine">Child Poverty Action Lab</p>
            <p class="m-0 mt-3 font-mono text-xs text-muted">Dallas, Texas</p>
            <p class="m-0 mt-3 flex gap-4">
              <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
              <a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            </p>
          </div>
        </aside>
      </div>
    </LabeledSection>

    <LabeledSection>
      <blockquote class="m-0 font-serif text-[clamp(1.6rem,3.4vw,2.6rem)] leading-[1.15] tracking-[-0.01em] max-w-[28ch] text-balance">
        Public data is only useful when the people closest to a problem can act on it.
      </blockquote>
    </LabeledSection>

    <LabeledSection label="What we've built at CPAL">
      <p class="m-0 mb-6 text-muted max-w-[62ch]">A snapshot of the work, from the decisions it informs to the infrastructure underneath.</p>
      <ul class="list-none m-0 p-0 max-w-[65ch] text-[1.05rem] leading-relaxed border-t border-line">
        {built.map((item) => (
          <li class="border-b border-line py-4">
            {item.text}{item.link && <a href={item.link.href} target="_blank" rel="noopener noreferrer">{item.link.label}</a>}{item.after}
          </li>
        ))}
      </ul>
    </LabeledSection>

    {mediaGroups.length > 0 && (
      <LabeledSection label="Selected media & visualizations">
        <div class="flex flex-col gap-10 max-w-[65ch]">
          {mediaGroups.map((g) => (
            <div>
              <h3 class="eyebrow m-0 mb-2">{g.label}</h3>
              <ul class="list-none m-0 p-0">
                {g.items.map((m) => (
                  <li class="border-b border-line py-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <a href={m.href} target="_blank" rel="noopener noreferrer" class="font-medium">{m.outlet}</a>
                    <span>{m.title}</span>
                    <span class="ml-auto font-mono text-xs text-muted">{m.date}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </LabeledSection>
    )}

    <LabeledSection label="Domains, methods & stack">
      <SkillsGrid only={['Domains', 'Methods', 'Data Platform', 'AI Workflows']} />
    </LabeledSection>
  </div>
</BaseLayout>
